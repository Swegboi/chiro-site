---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Privacy" description="Privacy information for the McCandless Township Chiropractic website.">
	<section class="page-hero">
		<div class="container page-hero__grid">
			<div>
				<span class="eyebrow">Privacy</span>
				<h1>A simple boundary.</h1>
			</div>
			<p class="page-hero__copy">This starter site is designed to share practice information without collecting sensitive health information.</p>
		</div>
	</section>

	<section class="section section--white">
		<div class="container">
			<div class="prose">
				<h2>What this website is for</h2>
				<p>This website provides general information about the practice, including services, hours, location, and ways to contact the office.</p>
				<h3>What it should not collect</h3>
				<ul>
					<li>Symptoms, diagnoses, or medical history</li>
					<li>Insurance member IDs or medical records</li>
					<li>Payment-card information</li>
				</ul>
				<h3>Third-party services</h3>
				<p>The Contact page embeds a Google Map to help visitors find the office. Google may process technical information when the map loads. The office currently operates as a cash practice, and this website does not collect payment-card information. Add any approved scheduling or analytics services here before launch, and confirm their privacy and compliance suitability with the practice.</p>
				<div class="content-note"><strong>Before launch:</strong> Have the practice owner review this page and add any required legal or third-party service disclosures.</div>
			</div>
		</div>
	</section>
</Layout>
