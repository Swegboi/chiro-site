---
import type { Service } from '../data/site';

interface Props {
	service: Service;
}

const { service } = Astro.props;
---

<article class="service-card">
	<div class="service-card__topline">
		<span class="service-card__number">{service.number}</span>
		<span class="service-card__rule" aria-hidden="true"></span>
	</div>
	<h3>{service.title}</h3>
	<p>{service.description}</p>
	<a class="text-link" href={service.href}>{service.linkLabel ?? 'Explore services'} <span aria-hidden="true">&rarr;</span></a>
</article>
